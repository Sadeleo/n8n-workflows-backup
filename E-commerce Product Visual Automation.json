            {
              "id": "2",
              "name": "emailBody",
              "value": "=Hi there,\n\nYour product visual for \"{{ $(\"Google Form Submission\").item.json.productName }}\" has been generated!\n\nProduct Details:\n- Visual Type: {{ $(\"Google Form Submission\").item.json.visualType }}\n- Brand Style: {{ $(\"Google Form Submission\").item.json.brandStyle }}\n- Target Audience: {{ $(\"Google Form Submission\").item.json.targetAudience }}\n\nThe generated image is attached to this email. You can now use it for your marketing campaigns!\n\nBest regards,\nYour E-commerce Visual Automation Team",
              "type": "string"
            },
            {
              "id": "3",
