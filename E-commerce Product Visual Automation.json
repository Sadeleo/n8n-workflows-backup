    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an expert e-commerce product advertising prompt engineer.\n\nCreate a detailed image generation prompt using this information:\n\nProduct Name:{{ $json['Product Name '] }}\nDescription: {{ $json['Product Description '] }}\nBrand Style:{{ $json['Brand Style '] }}\nBackground:{{ $json['Background Preference '] }}{{ $json['Target Audience '] }}\nAudience:{{ $json['Visual Type '] }}\nVisual Type: {{ $json['Visual Type '] }}\n\nMake it highly cinematic, professional, realistic,\ncommercial-quality, visually attractive, and optimized\nfor product marketing.",
        "options": {
          "systemMessage": "You are an expert at creating image generation prompts for e-commerce products. Create detailed, vivid prompts that result in professional product visuals suitable for marketing and advertising."
        }
      },
      "id": "5ddba444-9d78-4204-9c85-947b63e0e8be",
